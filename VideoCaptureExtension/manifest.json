{
  "manifest_version": 3,
  "name": "视频下载助手",
  "version": "1.2.0",
  "description": "在明确授权的网站上保存同一次正常播放产生的非加密媒体响应。",
  "permissions": ["activeTab", "debugger", "downloads", "storage"],
  "host_permissions": [
    "https://ke.renrenjiang.cn/*",
    "https://api.renrenjiang.cn/*",
    "https://qcloudvod.renrenjiang.cn/*",
    "https://playvideo.vodplayvideo.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "视频下载助手",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
